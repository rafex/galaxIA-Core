{
  "name": "@rafex/galaxia-atlas",
  "version": "0.1.8",
  "private": false,
  "type": "module",
  "description": "Atlas FHS P2P: pure bootstrap peer (DHT server + FloodSub) para el swarm FHS.",
  "bin": {
    "galaxia-atlas": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "sh ../../helpers/scripts/shell/gen-version.sh 2>/dev/null || true; tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rafex/galaxia-fhs-node": "*",
    "@rafex/galaxia-fhs-protocol": "npm:@rafex_labs/galaxia-fhs-protocol@^0.1.28",
    "bonjour-service": "1.4.2",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
