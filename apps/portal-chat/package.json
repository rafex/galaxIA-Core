{
  "name": "@rafex/galaxia-portal-chat",
  "version": "0.1.9",
  "private": false,
  "type": "module",
  "description": "Portal de chat web del cliente FHS v0.1 (Vite + vanilla TypeScript + HTML5 + CSS3). Separado del protocolo \u2014 ver apps/portal-tui para el cliente de terminal.",
  "bin": {
    "galaxia-portal-chat": "./dist/server.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "npm run generate:cert && vite",
    "build": "sh ../../helpers/scripts/shell/gen-version.sh 2>/dev/null || true; tsc && vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/generate-dev-cert.mjs && node dist/server.js",
    "preview": "npm run generate:cert && vite preview",
    "generate:cert": "node scripts/generate-dev-cert.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vite": "8.1.3"
  },
  "dependencies": {
    "@fastify/static": "9.3.0",
    "@bufbuild/protobuf": "^2.13.0",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/crypto": "5.1.22",
    "@libp2p/identify": "^4.1.12",
    "@libp2p/websockets": "10.1.19",
    "@rafex/galaxia-fhs-protocol": "npm:@rafex_labs/galaxia-fhs-protocol@^0.1.33",
    "@multiformats/multiaddr": "13.0.3",
    "fastify": "5.10.0",
    "libp2p": "3.3.8",
    "multiformats": "^13.3.1"
  }
}
