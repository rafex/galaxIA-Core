{
  "name": "@rafex/galaxia-portal-chat",
  "version": "0.1.5",
  "private": false,
  "type": "module",
  "description": "Portal de chat web del cliente FHS v0.1 (Vite + vanilla TypeScript + HTML5 + CSS3). Separado del protocolo \u2014 ver apps/portal-tui para el cliente de terminal.",
  "bin": {
    "galaxia-portal-chat": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "sh ../../helpers/scripts/shell/gen-version.sh 2>/dev/null || true; tsc && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vite": "8.1.3"
  },
  "dependencies": {
    "@fastify/http-proxy": "11.5.0",
    "@fastify/static": "9.3.0",
    "@rafex/galaxia-fhs-protocol": "npm:@rafex_labs/galaxia-fhs-protocol@^0.1.26",
    "fastify": "5.10.0"
  }
}
