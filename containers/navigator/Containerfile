# Contenedor de Navigator (Orquestador P2P) FHS — DEC-0088
# Puerto 8090: API REST/SSE para portal-chat.
# Puerto 4010: WebSocket libp2p (para misiones P2P directas).
#
# @rafex/galaxia-fhs-protocol se instala desde GitHub Packages.
# Pasar el token como secret de BuildKit:
#   podman build --secret id=node_auth_token,env=NODE_AUTH_TOKEN \
#     -f containers/navigator/Containerfile .

FROM docker.io/library/node:20-alpine AS builder
WORKDIR /app

ARG COMMIT_HASH=unknown
ARG BUILD_DATE=unknown

# Copiar metadatos del workspace
COPY package*.json .npmrc ./
COPY packages/fhs-node/package.json ./packages/fhs-node/
COPY apps/navigator/package.json ./apps/navigator/

# Instalar dependencias (fhs-protocol instala desde npmjs.org via alias npm:@rafex_labs/)
RUN npm install --ignore-scripts

# Copiar código fuente y construir
COPY packages/fhs-node ./packages/fhs-node
COPY apps/navigator ./apps/navigator

# Generar version.json
RUN printf '{"commit":"%s","date":"%s"}\n' "$COMMIT_HASH" "$BUILD_DATE" \
      > apps/navigator/src/version.json

RUN npm run build -w packages/fhs-node && \
    npm run build -w apps/navigator

# Imagen final mínima
FROM docker.io/library/node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8090
ENV HOST=0.0.0.0
ENV FHS_P2P_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4010/ws

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/fhs-node/package.json ./packages/fhs-node/
COPY --from=builder /app/packages/fhs-node/dist ./packages/fhs-node/dist
COPY --from=builder /app/apps/navigator/package.json ./apps/navigator/
COPY --from=builder /app/apps/navigator/dist ./apps/navigator/dist

WORKDIR /app/apps/navigator
EXPOSE 8090
EXPOSE 4010

CMD ["node", "dist/index.js"]
