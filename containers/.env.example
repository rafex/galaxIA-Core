# Variables para containers/compose.release.yaml — copiar a .env en el
# mismo directorio y editar según tu despliegue. Ver docs/instalacion.md.

# Versión a desplegar (tag de imagen en ghcr.io/rafex/galaxia-*).
# "latest" apunta siempre a la última publicada; fijar una versión exacta
# (ej. v0.1.0-alpha.1) es más reproducible para un despliegue real.
GALAXIA_VERSION=latest

# Puertos publicados en el host. Cambiar solo si ya usas esos puertos para
# otra cosa.
PORTAL_PORT=8443
PORTAL_CERT_CN=localhost
PORTAL_CERT_SAN=DNS:localhost,IP:127.0.0.1
# Carpeta persistente del certificado HTTPS del portal. Debe contener
# portal.crt/portal.key si se administran certificados propios.
PORTAL_CERTS_DIR=../certs/portal-chat
# Uno o más peers TLS de bootstrap del swarm. No tiene que ser Navigator.
FHS_BOOTSTRAP_ADDRS=/ip4/127.0.0.1/tcp/4010/tls/ws

# Bootstrap y anuncio P2P para un despliegue multi-host.
# FHS_BOOTSTRAP_ADDRS=/ip4/192.168.1.50/tcp/4001/tls/ws/p2p/<atlas-peer-id>
# FHS_ANNOUNCE_ADDRS=/ip4/192.168.1.51/tcp/4010/tls/ws/p2p/<navigator-peer-id>
