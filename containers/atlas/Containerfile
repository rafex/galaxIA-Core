# Contenedor de Atlas (Bootstrap Peer) FHS P2P — DEC-0088
# Pure libp2p bootstrap peer: DHT server + FloodSub relay.
# Puerto 8081: API REST de health/status.
# Puerto 4001: WebSocket libp2p (bootstrap multiaddr).

FROM docker.io/library/node:20-alpine AS builder
WORKDIR /app

ARG COMMIT_HASH=unknown
ARG BUILD_DATE=unknown

# better-sqlite3 es un binding nativo
RUN apk add --no-cache python3 make g++

# Copiar metadatos del workspace
COPY package*.json ./
COPY packages/fhs-protocol/package.json ./packages/fhs-protocol/
COPY packages/fhs-node/package.json ./packages/fhs-node/
COPY apps/atlas/package.json ./apps/atlas/

# Instalar dependencias
RUN npm ci

# Copiar código fuente y construir
COPY packages/fhs-protocol ./packages/fhs-protocol
COPY packages/fhs-node ./packages/fhs-node
COPY apps/atlas ./apps/atlas

# Generar version.json
RUN printf '{"commit":"%s","date":"%s"}\n' "$COMMIT_HASH" "$BUILD_DATE" \
      > apps/atlas/src/version.json

RUN npm run build -w packages/fhs-protocol && \
    npm run build -w packages/fhs-node && \
    npm run build -w apps/atlas

# Imagen final mínima
FROM docker.io/library/node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8081
ENV HOST=0.0.0.0
ENV ATLAS_DB_PATH=/app/apps/atlas/data/atlas-metrics.db
ENV FHS_P2P_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001/ws
ENV IDENTITY_KEY_PATH=/app/apps/atlas/data/.fhs-identity-atlas.json

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/fhs-protocol/package.json ./packages/fhs-protocol/
COPY --from=builder /app/packages/fhs-protocol/dist ./packages/fhs-protocol/dist
COPY --from=builder /app/packages/fhs-node/package.json ./packages/fhs-node/
COPY --from=builder /app/packages/fhs-node/dist ./packages/fhs-node/dist
COPY --from=builder /app/apps/atlas/package.json ./apps/atlas/
COPY --from=builder /app/apps/atlas/dist ./apps/atlas/dist

WORKDIR /app/apps/atlas
EXPOSE 8081
EXPOSE 4001

CMD ["node", "dist/index.js"]
