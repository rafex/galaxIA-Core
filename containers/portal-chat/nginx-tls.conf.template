# HTTPS-only static portal. Chat sessions use the libp2p/WSS multiaddr baked
# into the frontend at build time; there is no HTTP proxy or cleartext API
# path in this container.
server {
    listen 443 ssl;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate     /etc/nginx/certs/portal.crt;
    ssl_certificate_key /etc/nginx/certs/portal.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # La versión identifica exactamente la imagen desplegada. No debe quedar
    # atrapada en la caché del navegador después de actualizar el contenedor.
    location = /version.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
