# Contenedor del frontend FHS Chat Web.
# Sirve la aplicación compilada con Nginx sobre HTTPS; la sesión de chat
# sale directamente del navegador hacia Navigator por libp2p/WSS.

FROM node:22-alpine AS builder
WORKDIR /app

ARG COMMIT_HASH=unknown
ARG BUILD_DATE=unknown
ARG VITE_FHS_NAVIGATOR_MULTIADDR=

# fhs-protocol es ahora un paquete npm externo (galaxIA-SDK) — no se copia local
COPY package*.json ./
COPY apps/portal-chat/package.json ./apps/portal-chat/

RUN npm install --workspace=apps/portal-chat

COPY apps/portal-chat ./apps/portal-chat

# Generar version.json para el frontend
RUN printf '{"commit":"%s","date":"%s"}\n' "$COMMIT_HASH" "$BUILD_DATE" \
      > apps/portal-chat/public/version.json

ENV VITE_FHS_NAVIGATOR_MULTIADDR=$VITE_FHS_NAVIGATOR_MULTIADDR
RUN npm run build -w apps/portal-chat

FROM docker.io/library/nginx:alpine
RUN apk add --no-cache openssl
COPY --from=builder /app/apps/portal-chat/dist /usr/share/nginx/html

# La imagen base trae su propio /etc/nginx/conf.d/default.conf (página de
# bienvenida) — sin borrarlo, compite por el puerto 80 con el nuestro
# ("conflicting server name localhost on 0.0.0.0:80", visto en pruebas
# reales) y cuál gana queda indefinido.
RUN rm -f /etc/nginx/conf.d/default.conf

COPY containers/portal-chat/nginx-tls.conf.template /etc/nginx/templates/nginx.conf.template
COPY containers/portal-chat/generate-cert.sh /docker-entrypoint.d/10-generate-cert.sh
RUN chmod 0755 /docker-entrypoint.d/10-generate-cert.sh

ENV PORTAL_CERT_CN=localhost
ENV PORTAL_CERT_SAN=DNS:localhost,IP:127.0.0.1

EXPOSE 443

CMD ["nginx", "-g", "daemon off;"]
